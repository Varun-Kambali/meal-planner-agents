{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CheckedRecipe": {
      "additionalProperties": false,
      "description": "A draft with its numbers from nutrition-mcp and the checks it has failed so far.",
      "properties": {
        "spec": {
          "$ref": "#/$defs/SlotSpec"
        },
        "draft": {
          "$ref": "#/$defs/DraftRecipe"
        },
        "nutrition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MealResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/Failure"
          },
          "title": "Failures",
          "type": "array"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "portion_scale": {
          "default": 1.0,
          "title": "Portion Scale",
          "type": "number"
        }
      },
      "required": [
        "spec",
        "draft",
        "nutrition",
        "failures",
        "attempts"
      ],
      "title": "CheckedRecipe",
      "type": "object"
    },
    "DayReport": {
      "additionalProperties": false,
      "description": "A day's totals against its day type. Keys are nutrition-mcp's nutrient names.",
      "properties": {
        "day": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "title": "Day",
          "type": "string"
        },
        "totals": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Totals",
          "type": "object"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/Failure"
          },
          "title": "Failures",
          "type": "array"
        },
        "soft": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Soft",
          "type": "object"
        }
      },
      "required": [
        "day",
        "totals",
        "failures",
        "soft"
      ],
      "title": "DayReport",
      "type": "object"
    },
    "DayType": {
      "additionalProperties": false,
      "description": "One kind of day, such as a training day, with the daily targets it is held to.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,29}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kcal": {
          "exclusiveMinimum": 0,
          "title": "Kcal",
          "type": "number"
        },
        "protein_g": {
          "exclusiveMinimum": 0,
          "title": "Protein G",
          "type": "number"
        },
        "carbs_g": {
          "exclusiveMinimum": 0,
          "title": "Carbs G",
          "type": "number"
        },
        "fat_g": {
          "exclusiveMinimum": 0,
          "title": "Fat G",
          "type": "number"
        },
        "sat_fat_g_max": {
          "exclusiveMinimum": 0,
          "title": "Sat Fat G Max",
          "type": "number"
        },
        "fibre_g_min": {
          "exclusiveMinimum": 0,
          "title": "Fibre G Min",
          "type": "number"
        },
        "extra": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NutrientTarget"
          },
          "title": "Extra",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kcal",
        "protein_g",
        "carbs_g",
        "fat_g",
        "sat_fat_g_max",
        "fibre_g_min"
      ],
      "title": "DayType",
      "type": "object"
    },
    "DraftIngredient": {
      "additionalProperties": false,
      "description": "One catalogue ingredient and how much of it, in grams.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "grams": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Grams",
          "type": "number"
        }
      },
      "required": [
        "id",
        "grams"
      ],
      "title": "DraftIngredient",
      "type": "object"
    },
    "DraftRecipe": {
      "additionalProperties": false,
      "description": "A recipe as the model writes it. It carries no nutrition numbers: those come from code.",
      "properties": {
        "day": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "title": "Day",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "cuisine": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Cuisine",
          "type": "string"
        },
        "ingredients": {
          "items": {
            "$ref": "#/$defs/DraftIngredient"
          },
          "maxItems": 15,
          "minItems": 1,
          "title": "Ingredients",
          "type": "array"
        },
        "steps": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "active_min": {
          "minimum": 0,
          "title": "Active Min",
          "type": "integer"
        },
        "total_min": {
          "minimum": 0,
          "title": "Total Min",
          "type": "integer"
        },
        "gear": {
          "items": {
            "enum": [
              "air_fryer",
              "pressure_cooker",
              "microwave",
              "oven",
              "stovetop_pan",
              "kadhai",
              "blender",
              "jar_with_lid",
              "rice_cooker",
              "steamer",
              "kettle"
            ],
            "type": "string"
          },
          "title": "Gear",
          "type": "array"
        },
        "cook_when": {
          "enum": [
            "fresh",
            "evening_before",
            "night_before"
          ],
          "title": "Cook When",
          "type": "string"
        },
        "store": {
          "title": "Store",
          "type": "string"
        },
        "swap": {
          "title": "Swap",
          "type": "string"
        },
        "fits": {
          "title": "Fits",
          "type": "string"
        }
      },
      "required": [
        "day",
        "title",
        "cuisine",
        "ingredients",
        "steps",
        "active_min",
        "total_min",
        "gear",
        "cook_when",
        "store",
        "swap",
        "fits"
      ],
      "title": "DraftRecipe",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "description": "A rule a recipe or day misses, in words the writer can act on.",
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "check",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FoodRules": {
      "additionalProperties": false,
      "description": "Diet, allergens and foods to avoid or favour, and the cuisines to draw on.",
      "properties": {
        "diet": {
          "enum": [
            "veg",
            "egg",
            "non_veg",
            "vegan"
          ],
          "title": "Diet",
          "type": "string"
        },
        "exclude_allergens": {
          "items": {
            "enum": [
              "gluten",
              "milk",
              "egg",
              "peanut",
              "tree_nuts",
              "soy",
              "fish",
              "crustaceans",
              "sesame",
              "mustard"
            ],
            "type": "string"
          },
          "title": "Exclude Allergens",
          "type": "array"
        },
        "exclude_foods": {
          "items": {
            "type": "string"
          },
          "title": "Exclude Foods",
          "type": "array"
        },
        "liked_foods": {
          "items": {
            "type": "string"
          },
          "title": "Liked Foods",
          "type": "array"
        },
        "cuisines": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Cuisines",
          "type": "array"
        }
      },
      "required": [
        "diet",
        "exclude_allergens",
        "exclude_foods",
        "liked_foods",
        "cuisines"
      ],
      "title": "FoodRules",
      "type": "object"
    },
    "FoodSummary": {
      "description": "Enough to identify a food and to pick a unit that fits it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ingredient",
            "dish"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "regions": {
          "items": {
            "enum": [
              "north",
              "south",
              "east",
              "west"
            ],
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "diet": {
          "enum": [
            "veg",
            "egg",
            "non_veg",
            "vegan"
          ],
          "title": "Diet",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "units": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Every unit get_nutrition and compute_meal accept for this food, with the grams in one of each: g, the food's own measures, then the default katori for a dish served by the bowl and the volume units for a liquid.",
          "title": "Units",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "aliases",
        "regions",
        "diet",
        "source_ids",
        "units"
      ],
      "title": "FoodSummary",
      "type": "object"
    },
    "LogEntry": {
      "additionalProperties": false,
      "description": "One planned meal, on a date: how it went and what was eaten.\n\nA skipped meal lists nothing. Any other lists the foods that were eaten, at most as many as\none typed meal can hold.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "as_planned",
            "different_amount",
            "swapped",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LogItem"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "date",
        "slot_id",
        "status",
        "items"
      ],
      "title": "LogEntry",
      "type": "object"
    },
    "LogItem": {
      "additionalProperties": false,
      "description": "One food that was eaten: an id from nutrition-mcp, how many of a unit, and the unit.",
      "properties": {
        "food_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Food Id",
          "type": "string"
        },
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "food_id",
        "amount",
        "unit"
      ],
      "title": "LogItem",
      "type": "object"
    },
    "MealLog": {
      "additionalProperties": false,
      "description": "What was eaten over at most seven consecutive days, one entry for each slot of a date.",
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/LogEntry"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "version",
        "entries"
      ],
      "title": "MealLog",
      "type": "object"
    },
    "MealResult": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/NutritionResult"
          },
          "title": "Items",
          "type": "array"
        },
        "total": {
          "$ref": "#/$defs/Nutrients",
          "description": "Nutrient amounts, the sum over the items."
        },
        "total_incomplete": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Total Incomplete",
          "type": "object"
        },
        "glycemic_load": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Glycemic Load"
        },
        "glycemic_load_missing": {
          "items": {
            "type": "string"
          },
          "title": "Glycemic Load Missing",
          "type": "array"
        }
      },
      "required": [
        "items",
        "total",
        "total_incomplete",
        "glycemic_load",
        "glycemic_load_missing"
      ],
      "title": "MealResult",
      "type": "object"
    },
    "NoWasteRow": {
      "properties": {
        "ingredient": {
          "title": "Ingredient",
          "type": "string"
        },
        "window_start": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "title": "Window Start",
          "type": "string"
        },
        "failure": {
          "$ref": "#/$defs/Failure"
        }
      },
      "required": [
        "ingredient",
        "window_start",
        "failure"
      ],
      "title": "NoWasteRow",
      "type": "object"
    },
    "NutrientTarget": {
      "additionalProperties": false,
      "description": "A daily target for one nutrient: at least `value` (min) or at most `value` (max).",
      "properties": {
        "nutrient": {
          "enum": [
            "kcal",
            "protein_g",
            "fat_g",
            "sat_fat_g",
            "carbs_available_g",
            "sugars_g",
            "fibre_g",
            "sodium_mg",
            "iron_mg",
            "calcium_mg",
            "zinc_mg",
            "folate_ug",
            "vit_a_ug",
            "vit_b12_ug",
            "vit_c_mg",
            "vit_d_ug"
          ],
          "title": "Nutrient",
          "type": "string"
        },
        "kind": {
          "enum": [
            "min",
            "max"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "nutrient",
        "kind",
        "value"
      ],
      "title": "NutrientTarget",
      "type": "object"
    },
    "Nutrients": {
      "additionalProperties": false,
      "description": "Amounts of the 16 nutrients; null means not reported, which is not 0.",
      "properties": {
        "kcal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kcal"
        },
        "protein_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protein G"
        },
        "fat_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fat G"
        },
        "sat_fat_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sat Fat G"
        },
        "carbs_available_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carbs Available G"
        },
        "sugars_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sugars G"
        },
        "fibre_g": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fibre G"
        },
        "sodium_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sodium Mg"
        },
        "iron_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iron Mg"
        },
        "calcium_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calcium Mg"
        },
        "zinc_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zinc Mg"
        },
        "folate_ug": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Folate Ug"
        },
        "vit_a_ug": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vit A Ug"
        },
        "vit_b12_ug": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vit B12 Ug"
        },
        "vit_c_mg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vit C Mg"
        },
        "vit_d_ug": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vit D Ug"
        }
      },
      "title": "Nutrients",
      "type": "object"
    },
    "NutritionResult": {
      "description": "The nutrients in one amount of one food, with how the amount was worked out.",
      "properties": {
        "food": {
          "$ref": "#/$defs/FoodSummary"
        },
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "grams": {
          "title": "Grams",
          "type": "number"
        },
        "measure_assumption": {
          "title": "Measure Assumption",
          "type": "string"
        },
        "nutrients": {
          "$ref": "#/$defs/Nutrients",
          "description": "Nutrient amounts in `grams` of this food."
        },
        "incomplete": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Incomplete",
          "type": "object"
        },
        "raw_ingredient_totals": {
          "items": {
            "type": "string"
          },
          "title": "Raw Ingredient Totals",
          "type": "array"
        },
        "gi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gi"
        },
        "gi_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gi Ref"
        },
        "glycemic_load": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Glycemic Load"
        },
        "oil_assumption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Oil Assumption"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "food",
        "amount",
        "unit",
        "grams",
        "measure_assumption",
        "nutrients",
        "incomplete",
        "raw_ingredient_totals",
        "gi",
        "gi_ref",
        "glycemic_load",
        "oil_assumption",
        "sources"
      ],
      "title": "NutritionResult",
      "type": "object"
    },
    "PlanRules": {
      "additionalProperties": false,
      "description": "Everything a user enters about the plan they follow.",
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "day_types": {
          "items": {
            "$ref": "#/$defs/DayType"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Day Types",
          "type": "array"
        },
        "week": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 7,
          "propertyNames": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
