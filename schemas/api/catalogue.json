          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "enum": [
            "grain",
            "pulse",
            "dairy",
            "egg",
            "meat",
            "fish",
            "veg",
            "fruit",
            "nut_seed",
            "oil",
            "spice",
            "sauce",
            "sweetener",
            "other"
