# Copy to .env and fill in. The real .env is git-ignored.

# Gemini API key for writing recipes and reading typed meals (free tier: https://aistudio.google.com/apikey).
# LiteLLM reads it for any gemini/... model. A model from another provider needs that provider's
# own key variable instead (OPENAI_API_KEY, ANTHROPIC_API_KEY and so on).
GEMINI_API_KEY=your-gemini-key-here

# USDA FoodData Central key, only needed by `make foods` for records not in .cache/usda/ yet
# (free: https://fdc.nal.usda.gov/api-key-signup).
USDA_FDC_API_KEY=your-usda-key-here

# Langfuse keys, to trace each week and meal read (docs/decisions/0010-masked-langfuse-tracing.md).
# The plan's words and the typed text are masked in every trace. Leave either empty and tracing is
# off: no client is made and nothing is sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The Langfuse server. Empty means Langfuse Cloud's EU region; set https://us.cloud.langfuse.com
# for the US region, https://jp.cloud.langfuse.com for the Japan region, or the address of your
# own server. LANGFUSE_HOST is read when this is unset.
LANGFUSE_BASE_URL=

# App settings, all optional, each shown with its default. They are read in
# src/meal_planner/config.py, and a test keeps this list in step with it.
# The model for every call, as a LiteLLM id (https://docs.litellm.ai/docs/providers).
# MEAL_PLANNER_MODEL=gemini/gemini-3.1-flash-lite
# The most model calls in flight at once while a week is written (default 4). Lower it if the
# provider's rate limit is hit; the slots then take turns.
# MEAL_PLANNER_MAX_CONCURRENT_MODEL_CALLS=4
# Seconds one slot's writing call may take before it counts as timed out (default 120).
# MEAL_PLANNER_SLOT_CALL_TIMEOUT_S=120
# Seconds one model call to read a typed meal may take (default 30).
# MEAL_PLANNER_READER_CALL_TIMEOUT_S=30
# Recipe checks. Calories must be within this fraction of the slot's share (default 0.10), and
# protein at least this fraction of its share (default 0.90).
# MEAL_PLANNER_RECIPE_KCAL_TOLERANCE=0.10
# MEAL_PLANNER_RECIPE_PROTEIN_MIN_SHARE=0.90
# A day's calories must be within this fraction of its day type's target (default 0.05).
# MEAL_PLANNER_DAY_KCAL_TOLERANCE=0.05
# How many times a failing recipe goes back to the model (default 3), so a recipe is tried at
# most 4 times. The API accepts at most api.MAX_ATTEMPTS (4) tries for a recipe it is sent back,
# so raising this past 3 needs MAX_ATTEMPTS in src/meal_planner/api.py raised too.
# MEAL_PLANNER_MAX_REPAIR_ATTEMPTS=3
# Variety: two recipes of one slot whose ingredient sets overlap by this Jaccard similarity or
# more fail (default 0.6).
# MEAL_PLANNER_VARIETY_JACCARD_FAIL_AT=0.6
# No waste: an ingredient that keeps fewer than this many days once opened (default 7), and of
# which the week uses less than this share of a usual pack (default 0.5), is flagged.
# MEAL_PLANNER_NO_WASTE_KEEPS_DAYS=7
# MEAL_PLANNER_NO_WASTE_MIN_PACK_SHARE=0.5
# Fit portions (default true): a recipe whose calories are outside its slot's band has every gram
# scaled by one factor to the slot's share, and nutrition-mcp works the scaled recipe out again.
# Only a factor between the two bounds is used (defaults 0.5 and 2.0); past them, or when an
# ingredient would pass 1000 g, the writer is asked to redo the amounts.
# MEAL_PLANNER_FIT_PORTIONS=true
# MEAL_PLANNER_PORTION_SCALE_MIN=0.5
# MEAL_PLANNER_PORTION_SCALE_MAX=2.0
# Show the writer each ingredient's nutrition per 100 g and the slot's share of the day's limits
# (default true). Turn it off to compare with a writer that sees names and calorie bands only.
# MEAL_PLANNER_WRITER_NUTRIENT_HINTS=true
# The longest typed meal in characters (default 500). Longer is a 422.
# MEAL_PLANNER_MAX_MEAL_TEXT_CHARS=500
# Browser origins allowed to call the API, separated by commas. Unset or empty adds no CORS headers.
# MEAL_PLANNER_CORS_ORIGINS=http://localhost:5173
# The largest request body in bytes (default 65536), and for replacing one recipe, which sends
# the rest of the week back (default 131072). A bigger body gets a 413.
# MEAL_PLANNER_MAX_BODY_BYTES=65536
# MEAL_PLANNER_MAX_REPLACE_BODY_BYTES=131072
# Requests one client address may make to the /v1 routes in a minute (default 10). Over it, 429.
# MEAL_PLANNER_RATE_LIMIT_PER_MINUTE=10
# The request header that holds the visitor's address, for an app behind a host's proxy that sets
# it itself (CF-Connecting-IP on Render). Empty counts the connection's address; a header is read
# only when named here.
# MEAL_PLANNER_CLIENT_ADDRESS_HEADER=
# nutrition-mcp dataset folders to load beside its bundled data, separated as in PATH. Unset
# means this repository's data/foods, which the catalogue needs; empty means bundled data only.
# MEAL_PLANNER_NUTRITION_DATA_DIRS=/path/to/meal-planner-agents/data/foods
# The ingredients the writer may use (default: data/catalogue.yaml in this repository). Set it
# where the repository is not on disk.
# MEAL_PLANNER_CATALOGUE_PATH=/path/to/meal-planner-agents/data/catalogue.yaml
